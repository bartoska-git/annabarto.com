RewriteEngine On

# Serve public assets directly
RewriteCond %{REQUEST_URI} ^/public/
RewriteRule ^ - [L]

# Route homepage to pages/index.php
RewriteRule ^$ pages/index.php [L]

# Route production portfolio and work-samples category pages
RewriteRule ^production-portfolio$ pages/work-samples.php [L]
RewriteRule ^production-portfolio/([a-z-]+)$ pages/work-samples-category.php?category=$1 [L,QSA]
RewriteRule ^work-samples/([a-z-]+)$ pages/work-samples-category.php?category=$1 [L,QSA]

# Route requests to pages/ if PHP file exists
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/pages/%{REQUEST_URI}.php -f
RewriteRule ^(.+)$ pages/$1.php [L]
